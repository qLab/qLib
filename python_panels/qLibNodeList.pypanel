<pythonPanelDocument>
  <!-- This file contains definitions of Python interfaces and the
 interfaces menu.  It should not be hand-edited when it is being
 used by the application.  Note, that two definitions of the
 same interface or of the interfaces menu are not allowed
 in a single file. -->
  <interface name="nodeList_qL" label="Node List [qL]" icon="BUTTONS_listview" showNetworkNavigationBar="true" help_url="charcter:autorigs">
    <script><![CDATA[try:
    # prefer hutil
    from hutil.PySide import QtWidgets, QtGui, QtCore
except:
    # but fall back to previous approach
    from PySide2 import QtWidgets, QtGui, QtCore


import hou
import qlibutils


# TODO: options: show selected only, date: absolute/relative/both, filter applies to name or "all"
# TODO: implement "unsorted" list (e.g. top-to-down or left-to-right node order, depending on context)


class NodeList(QtWidgets.QWidget):

    def __init__(self, parent=None):
        super().__init__(parent)

        # settings
        self.settings = QtCore.QSettings("qLib", "NodeListPanel")

        self.view_author_username_only = self.settings.value("view/author_username_only", False, type=bool)
        self.view_date_format = self.settings.value("view/date_format", 0, type=int)

        # build UI
        layout = QtWidgets.QVBoxLayout(self)

        # menu bar
        self.menubar = QtWidgets.QMenuBar()

        # "columns" menu
        self.columns_menu = self.menubar.addMenu("Columns")
        self.columns_menu.aboutToShow.connect(lambda: self.populate_column_menu(self.columns_menu))

        # "author" menu
        self.author_menu = self.menubar.addMenu("Authors")
        self.author_group = QtWidgets.QActionGroup(self.author_menu)
        self.author_group.setExclusive(True)

        self.author_fullname_action = self.author_menu.addAction("Full Name")
        self.author_username_action = self.author_menu.addAction("Username Only")

        for action in (self.author_fullname_action, self.author_username_action, ):
            action.setCheckable(True)
            self.author_group.addAction(action)

        self.author_fullname_action.setChecked(not self.view_author_username_only)
        self.author_username_action.setChecked(self.view_author_username_only)

        self.author_group.triggered.connect(self.set_author_mode)

        # "dates" menu
        self.dates_menu = self.menubar.addMenu("Dates")
        self.dates_group = QtWidgets.QActionGroup(self.dates_menu)
        self.dates_group.setExclusive(True)

        self.dates_full_action = self.dates_menu.addAction("Full")
        self.dates_abs_action = self.dates_menu.addAction("Absolute")
        self.dates_rel_action = self.dates_menu.addAction("Relative")

        for i, action in enumerate((self.dates_full_action, self.dates_abs_action, self.dates_rel_action, )):
            action.setCheckable(True)
            self.dates_group.addAction(action)
            action.setChecked(self.view_date_format == i)
            action.triggered.connect(lambda checked=False, mode=i: self.set_dates_mode(mode) )


        # item model for table
        self.model = QtGui.QStandardItemModel()
        self.model.setHorizontalHeaderLabels(
            ["Name", "Type", "Author", "Modified", "Created", "Comment", "ToolId", "Defined By", ]
        )

        self.proxy = QtCore.QSortFilterProxyModel()
        self.proxy.setSourceModel(self.model)
        self.proxy.setFilterCaseSensitivity(QtCore.Qt.CaseInsensitive)
        # filter runs on all columns of a row (TODO: run it on only specific columns!)
        self.proxy.setFilterKeyColumn(-1)

        # main table view
        self.view = QtWidgets.QTableView()
        self.view.verticalHeader().setVisible(False)
        self.view.setShowGrid(False)
        self.view.setAlternatingRowColors(True)
        self.view.setSelectionBehavior(QtWidgets.QTableView.SelectRows)
        #self.view.setSelectionMode(QtWidgets.QTableView.MultiSelection)

        self.view.setModel(self.proxy)
        self.view.setSortingEnabled(True)
        self.view.sortByColumn(0, QtCore.Qt.AscendingOrder)
        
        self.view.selectionModel().selectionChanged.connect(self.selection_changed)

        font_metrics = QtGui.QFontMetrics(self.view.font())
        row_height = font_metrics.height()+2
        self.view.verticalHeader().setDefaultSectionSize(row_height)

        # restore column visibility
        for col in range(1, self.model.columnCount()):  # Keep Name visible
            visible = self.settings.value(f"columns/{col}/visible", True, type=bool)
            self.view.setColumnHidden(col, not visible)

        # filter bar
        self.filter = QtWidgets.QLineEdit()
        self.filter.textChanged.connect(self.proxy.setFilterFixedString)

        self.btn_refresh = QtWidgets.QPushButton("Refresh")
        self.btn_refresh.clicked.connect(lambda: self.refresh())

        layout.addWidget(self.menubar)
        layout.addWidget(self.view)
        layout.addWidget(self.filter)
        layout.addWidget(self.btn_refresh)

        # Header context menu
        header = self.view.horizontalHeader()
        header.setContextMenuPolicy(QtCore.Qt.CustomContextMenu)
        header.customContextMenuRequested.connect(self.show_header_menu)
        
        # set stretch modes for columns
        header.setSectionResizeMode(0, QtWidgets.QHeaderView.Stretch)
        #header.setSectionResizeMode(1, QtWidgets.QHeaderView.ResizeToContents)
        #header.setSectionResizeMode(2, QtWidgets.QHeaderView.ResizeToContents)
        #header.setSectionResizeMode(3, QtWidgets.QHeaderView.ResizeToContents)

        self.refresh()


    def populate_column_menu(self, menu):
        menu.clear()

        action = QtWidgets.QAction("Show All", menu)
        action.triggered.connect( lambda: self.set_column_visible(-1, True) )
        menu.addAction(action)
        action = QtWidgets.QAction("Show None", menu)
        action.triggered.connect( lambda: self.set_column_visible(-1, False) )
        menu.addAction(action)
        menu.addSeparator()

        for col in range(1, self.model.columnCount()): # Keep Name always visible
            name = self.model.headerData(col, QtCore.Qt.Horizontal)
            action = QtWidgets.QAction(name, menu)
            action.setCheckable(True)
            action.setChecked(not self.view.isColumnHidden(col))
            action.toggled.connect( lambda checked, c=col: self.set_column_visible(c, checked) )
            menu.addAction(action)


    def set_author_mode(self, action):
        """.
        """
        self.view_author_username_only = action==self.author_username_action
        self.settings.setValue("view/author_username_only", self.view_author_username_only)
        self.refresh()


    def set_dates_mode(self, mode):
        """.
        """
        self.view_date_format = mode
        self.settings.setValue("view/date_format", mode)
        self.refresh()


    def refresh(self):
        """.
        """
        selection = self.view.selectionModel()
        block_signals = selection.blockSignals(True)
        self.model.setRowCount(0)

        pane = kwargs["paneTab"]
        pwd = pane.pwd()
        sel = hou.selectedNodes()

        date_format = [ None, True, False ][ self.view_date_format ]

        for node in pwd.children():

            row = [
                name:=QtGui.QStandardItem(node.name()), # TODO: store actual node object!
                type:=QtGui.QStandardItem( node.type().name() ),
                QtGui.QStandardItem( qlibutils.get_node_author(node, self.view_author_username_only) ),
                QtGui.QStandardItem( qlibutils.date_string(node.modificationTime(), absolute=date_format) ), # TODO: store timestamp for sort and string for display
                QtGui.QStandardItem( qlibutils.date_string(node.creationTime(), absolute=date_format) ),
                QtGui.QStandardItem( node.comment() ),
                QtGui.QStandardItem( node.userData("___toolid___") or "" ),
                QtGui.QStandardItem( qlibutils.get_node_defined_by(node) ),
            ]

            try:
                name.setIcon(hou.qt.Icon(node.type().icon()))
            except:
                pass # some OPs might have no icon at all

            # colorise text with node color (TODO: have an option for this)
            if True:
                c = node.color()
                if not qlibutils.colors_close(c, node.type().defaultColor()):
                    c = QtGui.QColor.fromRgbF(*c.rgb())
                    name.setForeground(c)

            # display bypassed nodes in italic
            if hasattr(node, "isBypassed") and node.isBypassed():
                f = name.font()
                f.setItalic(True)
                name.setFont(f)

            # non-editable columns
            for i in [1, 2, 3, 4, 6, 7]:
                row[i].setEditable(False)

            # TODO: editable columns: node name=rename, node comment=edit comment

            self.model.appendRow(row)

        # select rows in the table that are actually selected in Houdini

        for row in range(self.proxy.rowCount()):
            index = self.proxy.index(row, 0)  # column 0 is Name
            if pwd.node(index.data()) in sel:
                selection.select(
                    index,
                    QtCore.QItemSelectionModel.Select
                    | QtCore.QItemSelectionModel.Rows
                )

        selection.blockSignals(block_signals)


    def selection_changed(self, selected):
        """.
        """
        pane = kwargs["paneTab"]
        pwd = pane.pwd()

        hou.clearAllSelected()
        for i in self.view.selectionModel().selectedRows():
            first_column = self.view.model().index(i.row(), 0)
            node_name = first_column.data(QtCore.Qt.ItemDataRole.DisplayRole)
            pwd.node(node_name).setSelected(True)


    def set_column_visible(self, column, visible):
        """.
        """
        cols = [ column ] if column>0 else range(1, self.model.columnCount())
        for col in cols:
            self.view.setColumnHidden(col, not visible)
            self.settings.setValue(f"columns/{col}/visible", visible)


    def show_header_menu(self, pos):
        """.
        """
        menu = QtWidgets.QMenu(self)
        header = self.view.horizontalHeader()
        self.populate_column_menu(menu)
        menu.exec_(header.mapToGlobal(pos))


def onCreateInterface():
    return NodeList()

def onNodePathChanged(node):
    #print("onNodePathChanged()")
    #print("node: "+str(node))
    pane = kwargs["paneTab"]
    root = pane.activeInterfaceRootWidget()
    root.refresh()
]]></script>
    <includeInPaneTabMenu menu_position="0" create_separator="false"/>
    <includeInToolbarMenu menu_position="201" create_separator="false"/>
    <help><![CDATA[]]></help>
  </interface>
